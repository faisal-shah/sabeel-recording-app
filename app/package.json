{
  "name": "@sabeel/app",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "EXPO_PUBLIC_COMMIT=$(git rev-parse --short HEAD) expo run:android",
    "web": "expo start --web",
    "web:export": "EXPO_PUBLIC_COMMIT=$(git rev-parse --short HEAD) expo export --platform web --output-dir dist-web --clear",
    "web:export:maps": "EXPO_PUBLIC_COMMIT=$(git rev-parse --short HEAD) expo export --platform web --output-dir dist-web --clear --source-maps",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/native": "^7.3.13",
    "@react-navigation/native-stack": "^7.18.5",
    "@sabeel/shared": "*",
    "@sentry/browser": "^10.37.0",
    "@sentry/react-native": "~7.11.0",
    "expo": "~57.0.4",
    "expo-audio": "~57.0.2",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-notifications": "~57.0.11",
    "expo-sharing": "~57.0.7",
    "expo-status-bar": "~57.0.0",
    "firebase": "^12.15.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
