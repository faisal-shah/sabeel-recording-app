{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.log",
        "src",
        "test",
        "**/*.test.ts",
        "vitest.config.ts"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "app/dist-web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
        ]
      },
      {
        "source": "/_expo/static/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ],
    "predeploy": [
      "node scripts/web-release.mjs"
    ]
  },
  "emulators": {
    "auth": {
      "port": 61102
    },
    "functions": {
      "port": 61103
    },
    "firestore": {
      "port": 61100,
      "websocketPort": 61101
    },
    "storage": {
      "port": 61107
    },
    "ui": {
      "enabled": true,
      "port": 61104
    },
    "hub": {
      "port": 61105
    },
    "logging": {
      "port": 61106
    },
    "singleProjectMode": true
  }
}
