rules_version = '2';

// This bucket holds class audio. Clients NEVER read it through the Storage SDK:
// playback goes through a 12-hour V4 signed URL minted by a callable that has
// already checked enrolment, and signed URLs bypass these rules entirely.
//
// So `read: false` is not a temporary state to be relaxed later — it is the
// intended end state. There is exactly one hole, for staff uploading audio to a
// draft recording.
service firebase.storage {
  match /b/{bucket}/o {

    // Claims are what these rules trust, same as firestore.rules. A default of
    // '' means a claimless token fails every check.
    function isStaff() {
      return request.auth != null
        && request.auth.token.get('status', '') == 'active'
        && request.auth.token.get('role', '') in ['manager', 'admin'];
    }

    match /recordings/{recordingId}/audio.m4a {
      // WRITE-ONCE. `resource == null` means this only succeeds when no object
      // exists yet, so a published recording's audio can never be silently
      // swapped underneath students who have already listened to it. Replacing
      // bad audio goes through the clearRecordingAudio callable, which refuses
      // unless the recording is still a draft.
      //
      // Storage rules cannot read Firestore, so class scope is NOT expressible
      // here — this can only ask "is this an active staff member". The
      // authorization that matters happens in createRecording, which checks
      // class scope before handing out the id, and again at publish. The
      // residual is that any staff member could write audio into a draft whose
      // random id they know; they are trusted colleagues, and the alternative
      // (a staging path plus a server-side copy) doubles the bytes for a threat
      // that is not real here.
      //
      // Size and content type are enforced HERE rather than only in a callable,
      // because the upload goes straight to Storage — by the time a callable
      // saw it, the bytes would already have been paid for.
      allow write: if isStaff()
        && resource == null
        && request.resource.size < 300 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');

      allow read: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
